# 统一行尾：.editorconfig 要求 lf，但 Windows 上 git 默认 core.autocrlf=true
# 会把 .ts / .md / .yml 存成 CRLF，clone 到 Linux 侧（将来若接 CI）满屏假 diff。
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
