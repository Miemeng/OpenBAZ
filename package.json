{
  "name": "openbaz",
  "version": "0.1.0",
  "private": true,
  "description": "异步自走棋卡牌模拟器 — 单包，非 monorepo",
  "author": "OpenBaz",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "check:config": "node tools/check-config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify": "npm run check:config && npm run typecheck && npm run typecheck:client && npm run lint && npm run test && node simulator/run.ts --deckA decks/testA.yml --deckB decks/testB.yml --seed 42 && npm run build:web",
    "regression": "node tools/regression-check.mjs",
    "regression:update": "node tools/regression-check.mjs --update",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:web": "vite build",
    "prebuild:web": "npm run packs:manifest",
    "preview:web": "vite preview",
    "packs:manifest": "node tools/packs-manifest.mjs",
    "dev": "vite",
    "sim:run": "node simulator/run.ts --deckA decks/testA.yml --deckB decks/testB.yml --seed 42",
    "sim:run:quiet": "node simulator/run.ts --deckA decks/testA.yml --deckB decks/testB.yml --seed 42 --quiet",
    "sim:validate": "node simulator/validate.ts",
    "desktop:host": "vite build --config vite.desktop.config.ts",
    "desktop:start": "npm run build:web && npm run desktop:host && electron .",
    "desktop:pack": "npm run build:web && npm run desktop:host && electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "js-yaml": "5.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "build": {
    "appId": "app.openbaz.desktop",
    "productName": "OpenBaz",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/dist/host.cjs",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packs/base",
        "to": "packs/base"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
