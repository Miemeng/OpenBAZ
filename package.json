{
  "name": "bazaarsim",
  "version": "0.0.0",
  "private": true,
  "description": "异步自走棋卡牌模拟器 — 单包，非 monorepo（框架设计 §2.5.1）",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "check:config": "node tools/check-config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify": "npm run check:config && npm run typecheck && npm run typecheck:client && npm run lint && npm run test && node simulator/run.ts --seed 42",
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "preview": "vite preview",
    "sim:run": "node simulator/run.ts --seed 42",
    "sim:run:quiet": "node simulator/run.ts --seed 42 --quiet",
    "sim:validate": "node simulator/validate.ts",
    "sim:glossary": "node simulator/glossary.ts",
    "sim:single": "node simulator/simulate.ts --deckA decks/a.yml --deckB decks/b.yml --seed 42",
    "sim:batch": "node simulator/simulate.ts --deckA decks/a.yml --deckB decks/b.yml -n 1000"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "js-yaml": "5.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  }
}
